
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Game library: Publicly readable, but only admin can write
    match /games/{gameId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'yorionlinegames@gmail.com';
    }

    // Global Stats: Publicly readable, increment-only write
    match /stats/global {
      allow read: if true;
      allow update: if request.resource.data.totalPlays >= resource.data.totalPlays;
      allow create: if request.auth != null && request.auth.token.email == 'yorionlinegames@gmail.com';
    }

    // User profiles: Publicly readable, only owner can write their own
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Fallback for everything else
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'yorionlinegames@gmail.com';
    }
  }
}
