rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Game library: Publicly readable, but only admin can write
    match /games/{gameId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'yogeshyadav0630@gmail.com';
    }
    
    // User profiles: Publicly readable, only owner can write their own
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Friend requests: Requires authentication
    match /friendRequests/{requestId} {
      allow read, write: if request.auth != null;
    }
    
    // Fallback for everything else
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
