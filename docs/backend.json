
{
  "entities": {
    "Game": {
      "title": "Game",
      "description": "Metadata for a playable arcade game.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "slug": { "type": "string" },
        "description": { "type": "string" },
        "thumbnail": { "type": "string" },
        "category": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "iframe_url": { "type": "string" },
        "featured": { "type": "boolean" },
        "trending": { "type": "boolean" },
        "date_added": { "type": "string", "format": "date" },
        "play_count": { "type": "number" },
        "likes": { "type": "number" },
        "rating": { "type": "number" }
      },
      "required": ["id", "title", "slug", "iframe_url"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "User specific data including favorites and public profile info.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "email": { "type": "string" },
        "favorites": { "type": "array", "items": { "type": "string" }, "description": "Array of game slugs" },
        "recent_plays": { "type": "array", "items": { "type": "string" }, "description": "Array of game slugs" },
        "xp": { "type": "number" }
      }
    },
    "FriendRequest": {
      "title": "FriendRequest",
      "description": "A request sent from one user to another to become friends.",
      "type": "object",
      "properties": {
        "senderId": { "type": "string" },
        "receiverId": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "accepted", "declined"] },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "auth": {
    "providers": ["google.com", "password"]
  },
  "firestore": {
    "/games/{gameId}": {
      "schema": "#/backend/entities/Game",
      "description": "Global game database."
    },
    "/users/{userId}": {
      "schema": "#/backend/entities/UserProfile",
      "description": "Public and private user profiles."
    },
    "/friendRequests/{requestId}": {
      "schema": "#/backend/entities/FriendRequest",
      "description": "Collection of friend requests between users."
    }
  }
}
